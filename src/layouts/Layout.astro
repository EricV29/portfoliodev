---
import "@fontsource/belanosima/400.css";
import "@fontsource/belanosima/600.css";
import "@fontsource/belanosima/700.css";
import Header from "../components/Header.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>

  <body>
    <div class="absolute top-0 right-0 w-[540px] h-[540px] z-0 pointer-events-none">
      <svg viewBox="0 175 400 500" class="w-full h-full">
        <text style="letter-spacing:5px;" fill="#fff" font-size="80" fill-opacity="0.2" class="uppercase" transform="rotate(-90 270 270)">
          <textPath href="#circlePath" startOffset="50%" text-anchor="middle" textLength="1600" lengthAdjust="spacingAndGlyphs">
            #OPEN TO WORK #OPEN TO WORK
          </textPath>
          <animateTransform attributeName="transform" attributeType="XML" type="rotate" from="360 270 270" to="0 270 270" dur="40s" repeatCount="indefinite"/>
        </text>
        <defs>
          <path id="circlePath" d="M260,260 m260,0 a260,260 0 1,0 -520,0 a260,260 0 1,0 520,0" />
        </defs>
      </svg>
    </div>
    <Header />
    <slot />
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
  }

  html {
    font-family: "Belanosima", sans-serif;
  }

  body {
    background-color: #1d1d1d;
    justify-content: center;
    min-height: 100vh;
    padding-left: 25px;
    padding-right: 25px;
    padding-top: 80px;
    overflow-x: hidden;
    position: relative;
  }

  @media (min-width: 768px) {
  body {
    padding-top: 100px;
  }
</style>
