<div
  class="absolute top-0 right-0 lg:w-[540px] md:w-[340px] w-[200px] lg:h-[540px] z-0 pointer-events-none overflow-hidden"
>
  <svg viewBox="0 175 400 500" class="w-full h-full">
    <text
      style="letter-spacing:5px;"
      fill="currentColor"
      font-size="80"
      class="uppercase text-white/20"
      transform="rotate(-90 270 270)"
    >
      <textPath
        href="#circlePath"
        startOffset="50%"
        text-anchor="middle"
        textLength="1600"
        lengthAdjust="spacingAndGlyphs"
      >
        #OPEN TO WORK #OPEN TO WORK
      </textPath>
      <animateTransform
        attributeName="transform"
        attributeType="XML"
        type="rotate"
        from="360 270 270"
        to="0 270 270"
        dur="40s"
        repeatCount="indefinite"></animateTransform>
    </text>
    <defs>
      <path
        id="circlePath"
        d="M260,260 m260,0 a260,260 0 1,0 -520,0 a260,260 0 1,0 520,0"></path>
    </defs>
  </svg>
</div>
