---
import Close from "./icons/Close.astro";
---

<div
  id="gallery"
  class="invisible fixed inset-0 z-50 bg-black/30 backdrop-blur-sm flex flex-col items-center justify-center space-y-4 min-h-screen"
>
  <button
    id="closeGallery"
    class="top-4 right-4 flex justify-center items-center absolute cursor-pointer hover:scale-105 transition-transform duration-200"
  >
    <div class="btns md:w-[50px] w-[30px] md:h-[50px] h-[30px]"></div>
    <span class="absolute md:w-7 w-5"><Close /></span>
  </button>

  <div class="w-full max-w-3xl p-5 lg:p-0">
    <img id="main-image" src="" class="w-full rounded-lg" alt="ImageMain" />
  </div>

  <div
    class="grid grid-cols-4 max-w-3xl gap-4 p-5 lg:p-0"
    id="thumbnail-container"
  >
  </div>
</div>

<script>
  // Function to load images from props
  (window as any).loadGalleryImages = function (media: string[]) {
    const mainContainer = document.querySelector("#gallery .w-full.max-w-3xl");
    const container = document.getElementById("thumbnail-container");
    const gallery = document.getElementById("gallery");

    if (!mainContainer || !container || !gallery) {
      console.error("No se encontraron los elementos");
      return;
    }

    function isVideo(url: string) {
      return /\.(mp4|webm|ogg|mov)$/i.test(url);
    }

    const firstMedia = media[0];

    if (isVideo(firstMedia)) {
      mainContainer.innerHTML = `
            <video id="main-media" class="w-full rounded-lg" controls>
                <source src="${firstMedia}" type="video/mp4">
                Tu navegador no soporta video.
            </video>
        `;
    } else {
      mainContainer.innerHTML = `
            <img id="main-media" src="${firstMedia}" class="w-full rounded-lg" alt="Main Media">
        `;
    }

    container.innerHTML = "";

    media.forEach((mediaUrl, index) => {
      if (isVideo(mediaUrl)) {
        const thumb = document.createElement("video");
        thumb.src = mediaUrl;
        thumb.className =
          "thumb rounded-lg md:h-24 h-14 object-cover cursor-pointer hover:opacity-80";
        thumb.muted = true;
        thumb.preload = "metadata";
        container.appendChild(thumb);
      } else {
        const thumb = document.createElement("img") as HTMLImageElement;
        thumb.src = mediaUrl;
        thumb.className =
          "thumb rounded-lg md:h-24 h-14 object-cover cursor-pointer hover:opacity-80";
        thumb.alt = `Thumb ${index + 1}`;
        container.appendChild(thumb);
      }
    });

    gallery.classList.remove("invisible");
    document.body.style.overflow = "hidden";
  };

  // Event listener para thumbnails
  document.addEventListener("click", function (e) {
    const target = e.target as HTMLElement;

    if (target?.classList?.contains("thumb")) {
      const mainContainer = document.querySelector(
        "#gallery .w-full.max-w-3xl"
      );

      if (mainContainer) {
        if (target.tagName === "VIDEO") {
          const videoSrc = (target as HTMLVideoElement).src;
          mainContainer.innerHTML = `
                    <video id="main-media" class="w-full rounded-lg" controls>
                        <source src="${videoSrc}" type="video/mp4">
                    </video>
                `;
        } else {
          const imgSrc = (target as HTMLImageElement).src;
          mainContainer.innerHTML = `
                    <img id="main-media" src="${imgSrc}" class="w-full rounded-lg" alt="Main Media">
                `;
        }
      }
    }
  });

  // Gallery close
  document
    .getElementById("closeGallery")
    ?.addEventListener("click", function () {
      const video = document.querySelector<HTMLVideoElement>("#main-media");
      if (video && video.tagName === "VIDEO") {
        video.pause();
        video.currentTime = 0; // opcional: reinicia al inicio
      }

      document.getElementById("gallery")?.classList.add("invisible");
      document.body.style.overflow = "auto";
    });
</script>
