---
import Close from "./icons/Close.astro";
---

<div
  id="gallery"
  class="invisible fixed inset-0 z-50 bg-black/30 backdrop-blur-sm flex flex-col items-center justify-center space-y-4 min-h-screen"
>
  <button
    id="closeGallery"
    class="top-4 right-4 flex justify-center items-center absolute cursor-pointer hover:scale-105 transition-transform duration-200"
  >
    <div class="btns md:w-[50px] w-[30px] md:h-[50px] h-[30px]"></div>
    <span class="absolute md:w-7 w-5"><Close /></span>
  </button>

  <div class="w-full max-w-3xl p-5 lg:p-0">
    <img id="main-image" src="" class="w-full rounded-lg" alt="ImageMain" />
  </div>

  <div
    class="flex overflow-x-auto snap-x snap-mandatory gap-4 w-full max-w-3xl p-5 lg:px-0 no-scrollbar"
    id="thumbnail-container"
  >
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  (window as any).loadGalleryImages = function (media: any) {
    const mainContainer = document.querySelector("#gallery .w-full.max-w-3xl");
    const container = document.getElementById("thumbnail-container");
    const gallery = document.getElementById("gallery");

    if (!mainContainer || !container || !gallery) {
      console.error("No se encontraron los elementos");
      return;
    }

    // Detectar si es link de YouTube
    function isYouTube(url: string) {
      return /youtube\.com|youtu\.be/.test(url);
    }

    // Obtener ID de YouTube
    function getYouTubeId(url: string) {
      const regExp =
        /^.*(?:youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
      const match = url.match(regExp);
      return match && match[1].length === 11 ? match[1] : null;
    }

    // Render principal
    function renderMain(url: string) {
      if (!mainContainer) return; // si no existe, salimos

      if (isYouTube(url)) {
        const ytId = getYouTubeId(url);
        if (ytId) {
          mainContainer.innerHTML = `
        <lite-youtube videoid="${ytId}" class="w-full rounded-lg"></lite-youtube>
      `;
        }
      } else {
        mainContainer.innerHTML = `
      <img id="main-media" src="${url}" class="w-full rounded-lg" alt="Main Media">
    `;
      }
    }

    // Mostrar la primera entrada
    const firstMedia = media[0];
    renderMain(firstMedia);

    // Render de thumbnails
    container.innerHTML = "";
    media.forEach((mediaUrl: string, index: string) => {
      if (isYouTube(mediaUrl)) {
        const ytId = getYouTubeId(mediaUrl);
        if (ytId) {
          const thumb = document.createElement("img");
          thumb.src = `https://img.youtube.com/vi/${ytId}/0.jpg`;
          thumb.className =
            "thumb rounded-lg md:h-24 h-14 object-cover cursor-pointer hover:opacity-80";
          thumb.alt = `YouTube Thumb ${index + 1}`;
          thumb.dataset.ytid = ytId;
          container.appendChild(thumb);
        }
      } else {
        const thumb = document.createElement("img");
        thumb.src = mediaUrl;
        thumb.className =
          "thumb rounded-lg md:h-24 h-14 object-cover cursor-pointer hover:opacity-80";
        thumb.alt = `Thumb ${index + 1}`;
        container.appendChild(thumb);
      }
    });

    // Mostrar galería
    gallery.classList.remove("invisible");
    document.body.style.overflow = "hidden";

    // Evento para thumbnails
    container.addEventListener("click", function (e: MouseEvent) {
      const target = e.target as HTMLElement;

      if (target?.classList?.contains("thumb")) {
        // Si es un thumbnail de YouTube
        const ytId = target.dataset?.ytid;
        if (ytId) {
          renderMain(`https://www.youtube.com/watch?v=${ytId}`);
        } else if ((target as HTMLImageElement).src) {
          renderMain((target as HTMLImageElement).src);
        }
      }
    });
  };

  // Cerrar galería
  document
    .getElementById("closeGallery")
    ?.addEventListener("click", function () {
      document.getElementById("gallery")?.classList.add("invisible");
      document.body.style.overflow = "auto";
    });
</script>
