---
import HomeIcon from "./icons/Home.astro";
import CvIcon from "./icons/Cv.astro";
---

<header
  class="fixed top-1 left-1/2 -translate-x-1/2 md:px-[25px] px-[10px] py-[10px] rounded-lg flex justify-between items-center w-11/12 z-3 bg-[#1d1d1dbb] backdrop-blur-sm"
>
  <div class="flex flex-row gap-x-4 md:gap-x-6">
    <a href="" class="flex justify-center items-center relative">
      <div class="btns w-[40px] h-[40px] md:w-[55px] md:h-[55px]"></div>
      <span class="absolute"><HomeIcon /></span>
    </a>

    <a href="" class="inline-flex justify-between items-center relative">
      <div class="btns md:w-[150px] w-[40px] h-[40px] md:h-[55px]"></div>
      <span
        class="absolute inset-0 flex items-center justify-center md:space-x-2"
      >
        <CvIcon />
        <span class="hidden md:inline">Descargar CV</span>
      </span>
    </a>
  </div>

  <nav class="hidden md:flex flex-row gap-x-6">
    <a href="">Proyectos</a>
    <a href="">Formación</a>
  </nav>

  <div class="md:hidden"></div>
</header>
