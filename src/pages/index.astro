---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import StackTech from "../components/StackTech.astro";
import Projects from "../components/Projects.astro";
import Formation from "../components/Formation.astro";
import Contact from "../components/Contact.astro";
---

<Layout
  title="Porfolio de Eric - Desarrollador y Programador Web"
  description="Contacta a Eric para crear tu aplicación, servicio, diseño y prototipo web o de escritorio."
>
  <main class="space-y-30">
    <!--PRESENTATION SECTION -->
    <Hero />

    <!--ABOUTME SECTION -->
    <section id="aboutme" class="w-auto text-center md:text-3xl">
      <p>
        Hola, yo soy <span class="text-[#1DFF52]">Eric</span>, profesional y
        egresado de la Licenciatura en Ingeniería de
        <span class="hidden lg:inline"><br /></span>
        <span class="text-[#1DFF52]">Software</span>, cuento con capacidad para
        el trabajo en
        <span class="text-[#1DFF52]">equipo</span>, tengo un enfoque
        <span class="hidden lg:inline"><br /></span>
        <span class="text-[#1DFF52]">creativo</span> para la resolución de problemas
        y habilidad para
        <span class="text-[#1DFF52]">gestionar</span> tareas <span
          class="text-[#1DFF52]">bajo</span
        >
        <span class="hidden lg:inline"><br /></span>
        <span class="text-[#1DFF52]">presión</span>.
      </p>
    </section>

    <!--EXPERIENCE SECTION -->
    <Experience />

    <!--STACTECK SECTION -->
    <StackTech />

    <!--PROJECTS SECTION -->
    <Projects />

    <!--FORMATION SECTION -->
    <Formation />

    <!--CONTACT SECTION -->
    <Contact />
  </main>
</Layout>
