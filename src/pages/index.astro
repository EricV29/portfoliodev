---
import Csharp from "../components/icons/Csharp.astro";
import Css from "../components/icons/Css.astro";
import Devexpress from "../components/icons/Devexpress.astro";
import Docker from "../components/icons/Docker.astro";
import Electron from "../components/icons/Electron.astro";
import Figma from "../components/icons/Figma.astro";
import Git from "../components/icons/Git.astro";
import Github from "../components/icons/Github.astro";
import Gmail from "../components/icons/Gmail.astro";
import Html from "../components/icons/Html.astro";
import Instagram from "../components/icons/Instagram.astro";
import Js from "../components/icons/Js.astro";
import Linkedin from "../components/icons/Linkedin.astro";
import Mysql from "../components/icons/Mysql.astro";
import Nodejs from "../components/icons/Nodejs.astro";
import Play from "../components/icons/Play.astro";
import Imagei from "../components/icons/Imagei.astro";
import Playwright from "../components/icons/Playwright.astro";
import Postgresql from "../components/icons/Postgresql.astro";
import Python from "../components/icons/Python.astro";
import React from "../components/icons/React.astro";
import Sqlserver from "../components/icons/Sqlserver.astro";
import Tailwind from "../components/icons/Tailwind.astro";
import Typescript from "../components/icons/Typescript.astro";
import Unity from "../components/icons/Unity.astro";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import imgVector from "../images/imgVector.webp";
import imgEric from "../images/imgEric.webp";
import imgIDBadge from "../images/imgIDBadge.webp";
import imgQrofive from "../images/imgQrofive.webp";
import imgCalendarW1S from "../images/imgCalendarW1S.webp";
import imgCalendarW1E from "../images/imgCalendarW1S.webp";
import imgLM from "../images/imgLM.webp";
import imgCalendarW2S from "../images/imgCalendarW2S.webp";
import imgCalendarW2E from "../images/imgCalendarW2E.webp";
import imgCertBD from "../images/imgCertBD.webp";
import imgCertPython from "../images/imgCertPython.webp";
import imgGA1 from "../images/GA/imgGA1.png";
import imgGA2 from "../images/GA/imgGA2.png";
import imgC1 from "../images/Courier/imgC1.png";
import demoC1 from "../images/Courier/demoC1.mp4";
import Gallery from "../components/Gallery.astro";

const projectsMedia = {
  projectGA: [imgGA1.src, imgGA2.src],
  projectCourier: [imgC1.src, demoC1],
};
---

<Layout>
  <main class="space-y-30">
    <section
      id="presentation"
      class="w-full lg:space-y-0 md:space-y-10 space-y-10"
    >
      <div
        class="w-full flex justify-between md:justify-center items-center md:gap-x-20 lg:gap-x-150"
      >
        <div class="flex flex-col font-semibold justify-center items-center">
          <h1 class="md:text-5xl text-1xl">
            Hola
            <span class="text-[#1DFF52]">,</span> soy
          </h1>
          <h1 class="text-2xl md:text-7xl text-[#1DFF52]">Eric Villeda</h1>
        </div>

        <p class="text-1xl md:text-3xl">
          lic. Ing. <span class="text-[#1DFF52]">Software</span>
        </p>
      </div>

      <div class="w-full md:flex md:justify-between">
        <div
          class="w-full flex justify-center items-center md:space-x-2 space-x-1 pt-2 pb-2 md:p-0 z-10"
        >
          <p class="font-bold md:text-7xl text-1xl text-[#1DFF52]">1</p>
          <div
            class="md:text-4xl text-1xl md:flex-col flex space-x-1 md:space-x-0"
          >
            <p>AÑO DE</p>
            <p>EXPERIENCIA</p>
          </div>
        </div>

        <div class="w-full flex justify-center relative z-0">
          <Image
            src={imgVector}
            loading="eager"
            alt="imageVector"
            class="absolute z-1 md:w-full w-[10rem] md:bottom-2 filter drop-shadow-[0_0_100px_#1DFF52]"
          />
          <Image
            src={imgEric}
            loading="eager"
            alt="imageEric"
            class="z-2 md:w-full w-[10rem]"
          />
        </div>

        <div
          class="w-full flex md:flex-col justify-center md:items-center md:space-y-4 space-x-5 md:space-x-0 pt-2 md:pt-0 z-10"
        >
          <div class="flex space-x-5">
            <a
              href="https://www.linkedin.com/in/eric-villeda-reyes-584856281/"
              target="_blank"
              rel="noopener"
              aria-label="LinkedIn"
              class="flex justify-center items-center relative"
            >
              <div class="btns md:w-[70px] w-[40px] md:h-[70px] h-[40px]"></div>
              <span class="absolute md:w-9 w-5"><Linkedin /></span>
            </a>
            <a
              href="https://github.com/EricV29"
              target="_blank"
              rel="noopener"
              aria-label="GitHub"
              class="flex justify-center items-center"
            >
              <div class="btns md:w-[70px] w-[40px] md:h-[70px] h-[40px]"></div>
              <span class="absolute md:w-9 w-5"><Github /></span>
            </a>
          </div>
          <a
            href="mailto:ericjared29@gmail.com?subject=Contacto%20desde%20portafolio&body=Hola,%20me%20gustaría%20ponerme%20en%20contacto%20contigo%20para%20hablar%20sobre%20[tema]."
            title="ericjared29@gmail.com"
            target="_blank"
            rel="noopener"
            aria-label="Gmail"
            class="flex justify-center items-center"
          >
            <div class="btns md:w-[70px] w-[40px] md:h-[70px] h-[40px]"></div>
            <span class="absolute md:w-9 w-5"><Gmail /></span>
          </a>
        </div>
      </div>
    </section>

    <section id="aboutme" class="w-auto text-center md:text-3xl">
      <p>
        Hola, yo soy <span class="text-[#1DFF52]">Eric</span>, profesional y
        egresado de la Licenciatura en Ingeniería de
        <span class="hidden lg:inline"><br /></span>
        <span class="text-[#1DFF52]">Software</span>, cuento con capacidad para
        el trabajo en
        <span class="text-[#1DFF52]">equipo</span>, tengo un enfoque
        <span class="hidden lg:inline"><br /></span>
        <span class="text-[#1DFF52]">creativo</span> para la resolución de problemas
        y habilidad para
        <span class="text-[#1DFF52]">gestionar</span> tareas <span
          class="text-[#1DFF52]">bajo</span
        >
        <span class="hidden lg:inline"><br /></span>
        <span class="text-[#1DFF52]">presión</span>.
      </p>
    </section>

    <section id="xp" class="w-full lg:space-y-20 space-y-10">
      <div
        class="w-full h-10 md:h-20 md:text-5xl text-2xl relative text-center flex justify-center items-center"
      >
        <span
          class="absolute z-0 text-[3rem] md:text-[7rem] font-semibold text-gray-200 opacity-10 leading-none select-none"
        >
          EXPERIENCIA
        </span>
        <p class="z-10 font-semibold">
          ¿<span class="text-[#1DFF52]">Experiencia</span>?
        </p>
      </div>

      <div
        class="w-full h-40 md:h-90 relative flex justify-center items-center"
      >
        <a
          href="mailto:ericjared29@gmail.com?subject=Contacto%20desde%20portafolio&body=Hola,%20me%20gustaría%20ponerme%20en%20contacto%20contigo%20para%20hablar%20sobre%20[tema]."
          title="ericjared29@gmail.com"
          class="absolute z-0"
        >
          <Image src={imgIDBadge} alt="imgIDBadge" class="lg:w-200" />
        </a>
      </div>

      <div
        class="w-full md:flex justify-center items-start md:space-x-5 lg:space-x-10 space-y-5"
      >
        <div class="md:w-80 flex flex-col items-center space-y-2">
          <Image
            src={imgQrofive}
            alt="imgCompany"
            class="md:w-50 h-20 md:h-auto"
          />
          <p class="md:text-3xl font-semibold">QROFIVE</p>
          <div class="flex space-x-3">
            <Image src={imgCalendarW1S} alt="dateStart" class="lg:w-20 w-10" />
            <Image src={imgCalendarW1E} alt="dateStart" class="lg:w-20 w-10" />
          </div>
        </div>

        <div
          class="md:w-200 flex flex-col items-center md:items-start w-full text-center md:text-start"
        >
          <div
            class="bg-[#1DFF52] text-[#000] lg:w-150 md:w-120 p-2 md:rounded-r-[20px] rounded-[10px] md:text-3xl font-semibold"
          >
            <p>Desarrollo Web (5SMART)</p>
          </div>
          <ul
            class="list-disc list-inside pl-3 lg:pl-10 md:pl-6 md:pt-5 pt-3 md:space-y-3 lg:text-2xl md:text-[20px] text-[10px] text-start"
          >
            <li>
              Diseño y desarrollo de módulos web e interfaces dinámicas con
              <span class="text-[#1DFF52]">C#</span>,
              <span class="text-[#1DFF52]">.Net</span> y
              <br class="hidden lg:block" />
              <span class="text-[#1DFF52]">JavaScript</span>, aplicando el
              patrón
              <span class="text-[#1DFF52]">Modelo-Vista-Controlador</span> (MVC)
              y
              <br class="hidden lg:block" />
              utilizando <span class="text-[#1DFF52]">DevExpress</span>.
            </li>
            <li>
              Gestión y optimización de bases de datos en
              <span class="text-[#1DFF52]">SQL Server</span>, implementando
              <br class="hidden lg:block" />
              operaciones CRUD y estableciendo conexiones eficientes con las interfaces
              <br class="hidden md:block" />
              de los módulos.
            </li>
            <li>
              Implementación de control de versiones con
              <span class="text-[#1DFF52]">Git</span> y trabajo colaborativo en
              <br class="hidden lg:block" />
              entornos ágiles.
            </li>
          </ul>
        </div>
      </div>

      <div
        class="w-full md:flex justify-center items-start md:space-x-10 space-y-5"
      >
        <div class="md:w-80 flex flex-col items-center space-y-2 text-center">
          <Image
            src={imgLM}
            alt="imgCompany"
            class="md:w-50 w-auto h-20 md:h-auto"
          />
          <p class="md:text-3xl font-semibold">
            Servicio Automotriz <br />"Don Fer"
          </p>
          <div class="flex space-x-3">
            <Image src={imgCalendarW2S} alt="dateStart" class="md:w-20 w-10" />
            <Image src={imgCalendarW2E} alt="dateStart" class="md:w-20 w-10" />
          </div>
        </div>
        <div
          class="md:w-200 flex flex-col items-center md:items-start w-full text-center md:text-start"
        >
          <div
            class="bg-[#1DFF52] text-[#000] lg:w-150 md:w-120 p-2 md:rounded-r-[20px] rounded-[10px] md:text-3xl font-semibold"
          >
            <p>Desarrollo Web Freelancer</p>
          </div>
          <ul
            class="list-disc list-inside pl-3 lg:pl-10 md:pl-6 md:pt-5 pt-3 md:space-y-3 lg:text-2xl md:text-[20px] text-[10px] text-start"
          >
            <li>
              Diseño colaborativo del sitio web mediante prototipos en
              <span class="text-[#1DFF52]">Figma</span>.
            </li>
            <li>
              Desarrollo full-stack con
              <span class="text-[#1DFF52]">Tailwind</span>,
              <span class="text-[#1DFF52]">TypeScript</span>,
              <span class="text-[#1DFF52]">React</span> (Front-end),
              <span class="text-[#1DFF52]">Node.js</span>
              <br class="hidden md:block" />
              y <span class="text-[#1DFF52]">Express</span> (Back-end), incluyendo
              pruebas unitarias con
              <span class="text-[#1DFF52]">Playwright</span>.
            </li>
            <li>
              Gestión de bases de datos en
              <span class="text-[#1DFF52]">PostgreSQL</span> y configuración de entornos
              de prueba
              <br class="hidden md:block" />
              con <span class="text-[#1DFF52]">Docker</span>.
            </li>
            <li>
              Despliegue y administración del sitio web en un servidor
              <span class="text-[#1DFF52]">Linux</span> de
              <br class="hidden md:block" />
              <span class="text-[#1DFF52]">DigitalOcean</span>.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section id="stacktec" class="w-full space-y-10">
      <div
        class="w-full h-10 md:h-20 md:text-5xl text-2xl relative text-center flex justify-center items-center"
      >
        <span
          class="absolute z-0 text-[3rem] md:text-[7rem] font-semibold text-gray-200 opacity-10 leading-none select-none"
        >
          STACK TEC
        </span>
        <p class="z-10 font-semibold">
          Mi <span class="text-[#1DFF52]">stack</span> tecnológico incluye:
        </p>
      </div>

      <div
        class="w-full h-auto px-5 flex flex-wrap justify-center md:gap-5 gap-3"
      >
        <div
          class="w-auto md:min-h-45 h-auto bg-[#111] rounded-3xl text-start md:px-10 px-5 md:py-4 py-2 space-y-5"
        >
          <p class="text-[#1DFF52]">Front-End</p>
          <div
            class="w-auto flex flex-wrap md:justify-start justify-center items-end gap-3"
          >
            <div class="flex flex-col justify-center items-center w-auto">
              <Html class="md:w-13 w-5" />
              <p>HTML</p>
            </div>
            <div class="flex flex-col justify-center items-center w-auto">
              <Css class="md:w-13 w-5" />
              <p>CSS</p>
            </div>
            <div class="flex flex-col justify-center items-center w-auto">
              <Js class="md:w-13 w-5" />
              <p>JavaScript</p>
            </div>
            <div class="flex flex-col justify-center items-center w-auto">
              <Typescript class="md:w-13 w-5" />
              <p>TypeScript</p>
            </div>
            <div class="flex flex-col justify-center items-center w-auto">
              <React class="md:w-13 w-5" />
              <p>ReactJS</p>
            </div>
            <div class="flex flex-col justify-center items-center w-auto">
              <Electron class="md:w-13 w-5" />
              <p>Electron</p>
            </div>
            <div class="flex flex-col justify-center items-center w-auto">
              <Tailwind class="md:w-13 w-5" />
              <p>Tailwind</p>
            </div>
            <div class="flex flex-col justify-center items-center w-auto">
              <Devexpress class="md:w-13 w-5" />
              <p>DevExpress</p>
            </div>
          </div>
        </div>

        <div
          class="w-auto md:min-h-45 bg-[#111] rounded-3xl text-start md:px-10 px-5 md:py-4 py-2 space-y-5"
        >
          <p class="text-[#1DFF52]">Back-End</p>
          <div
            class="w-auto flex flex-wrap gap-7 md:justify-start justify-center items-end"
          >
            <div
              class="flex flex-col justify-center items-center w-auto text-center"
            >
              <Nodejs class="md:w-13 w-5" />
              <p>NodeJS</p>
            </div>
            <div class="flex flex-col justify-center items-center w-auto">
              <Csharp class="md:w-13 w-5" />
              <p>CSharp</p>
            </div>
          </div>
        </div>

        <div
          class="w-auto md:min-h-45 bg-[#111] rounded-3xl text-start md:px-10 px-5 md:py-4 py-2 space-y-5"
        >
          <p class="text-[#1DFF52]">Bases de Datos</p>
          <div
            class="w-auto flex flex-wrap md:justify-start justify-center items-end gap-3"
          >
            <div class="flex flex-col items-center text-center w-auto">
              <Mysql class="md:w-13 w-5" />
              <p>MySQL</p>
            </div>
            <div class="flex flex-col justify-center items-center w-auto">
              <Sqlserver class="md:w-13 w-5" />
              <p>SQL Server</p>
            </div>
            <div class="flex flex-col justify-center items-center w-auto">
              <Postgresql class="md:w-13 w-5" />
              <p>PostgreSQL</p>
            </div>
          </div>
        </div>

        <div
          class="w-auto md:min-h-45 bg-[#111] rounded-3xl text-start md:px-10 px-5 md:py-4 py-2 space-y-5"
        >
          <p class="text-[#1DFF52]">Test</p>
          <div
            class="w-auto flex flex-wrap md:justify-start justify-center items-end gap-3"
          >
            <div class="flex flex-col items-center text-center w-auto">
              <Playwright class="md:w-13 w-5" />
              <p>Playwright</p>
            </div>
          </div>
        </div>

        <div
          class="w-auto md:min-h-45 bg-[#111] rounded-3xl text-start md:px-10 px-5 md:py-4 py-2 space-y-5"
        >
          <p class="text-[#1DFF52]">Herramientas</p>
          <div
            class="w-auto flex flex-wrap md:justify-start justify-center items-end gap-3"
          >
            <div class="flex flex-col items-center w-auto text-center">
              <Git class="md:w-13 w-5" />
              <p>Git</p>
            </div>
            <div class="flex flex-col items-center w-auto text-center">
              <Unity class="md:w-13 w-5" />
              <p>Unity</p>
            </div>
            <div class="flex flex-col items-center w-auto text-center">
              <Figma class="md:w-13 w-5" />
              <p>Figma</p>
            </div>
          </div>
        </div>

        <div
          class="w-auto md:min-h-45 bg-[#111] rounded-3xl text-start md:px-10 px-5 md:py-4 py-2 space-y-5"
        >
          <p class="text-[#1DFF52]">Aprendiendo</p>
          <div
            class="w-auto flex flex-wrap md:justify-start justify-center items-end gap-3"
          >
            <div class="flex flex-col items-center w-auto text-center">
              <Python class="md:w-13 w-5" />
              <p>Python</p>
            </div>
            <div class="flex flex-col items-center w-auto text-center">
              <Docker class="md:w-13 w-5" />
              <p>Docker</p>
            </div>
          </div>
        </div>
      </div>

      <div class="w-full flex flex-wrap justify-center items-center gap-5">
        <span
          class="bg-green-100 text-[#1DFF52] md:text-2xl font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-gray-700 dark:text-[#1DFF52] border border-[#1DFF52]"
          >Desarrollo Web</span
        >
        <span
          class="bg-green-100 text-[#1DFF52] md:text-2xl font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-gray-700 dark:text-[#1DFF52] border border-[#1DFF52]"
          >Gestión de Bases de Datos</span
        >
        <span
          class="bg-green-100 text-[#1DFF52] md:text-2xl font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-gray-700 dark:text-[#1DFF52] border border-[#1DFF52]"
          >Trabajo colaborativo</span
        >
        <span
          class="bg-green-100 text-[#1DFF52] md:text-2xl font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-gray-700 dark:text-[#1DFF52] border border-[#1DFF52]"
          >Prototipado</span
        >
        <span
          class="bg-green-100 text-[#1DFF52] md:text-2xl font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-gray-700 dark:text-[#1DFF52] border border-[#1DFF52]"
          >Adaptabilidad</span
        >
        <span
          class="bg-green-100 text-[#1DFF52] md:text-2xl font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-gray-700 dark:text-[#1DFF52] border border-[#1DFF52]"
          >Creatividad</span
        >
        <span
          class="bg-green-100 text-[#1DFF52] md:text-2xl font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-gray-700 dark:text-[#1DFF52] border border-[#1DFF52]"
          >Proactividad</span
        >
        <span
          class="bg-green-100 text-[#1DFF52] md:text-2xl font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-gray-700 dark:text-[#1DFF52] border border-[#1DFF52]"
          >Autodidacta</span
        >
      </div>
    </section>

    <section id="projects" class="w-full md:space-y-20 space-y-10 scroll-mt-20">
      <div
        class="w-full h-10 md:h-20 md:text-5xl text-2xl relative text-center flex justify-center items-center"
      >
        <span
          class="absolute z-0 text-[3rem] md:text-[7rem] font-semibold text-gray-200 opacity-10 leading-none select-none"
        >
          PROYECTOS
        </span>
        <p class="z-10 font-semibold">
          Mis <span class="text-[#1DFF52]">Proyectos</span>
        </p>
      </div>

      <Gallery />

      <div class="w-full flex flex-wrap gap-9 justify-center">
        <div
          class="lg:w-100 md:w-85 w-70 bg-[#111] p-3 rounded-[20px] space-y-3 border-l-1 border-t-1 border-[#fff]"
        >
          <Image
            src={imgGA1}
            alt="imgGA1"
            class="w-full md:h-[300px] h-[150px] object-cover object-left rounded-2xl bg-[#1d1d1d]"
          />
          <div class="w-full flex justify-between items-center md:text-2xl">
            <p class="font-semibold">Gestión automotriz</p>
            <button
              onclick={`window.loadGalleryImages(${JSON.stringify(projectsMedia.projectGA)})`}
              class="flex justify-center items-center relative cursor-pointer"
            >
              <div class="btns md:w-[50px] w-[30px] md:h-[50px] h-[30px]"></div>
              <span class="absolute md:w-7 w-5"><Play /></span>
            </button>
          </div>
          <div class="w-full">
            <span
              class="bg-green-100 text-green-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-gray-700 dark:text-green-400 border border-green-400"
              >TypeScript</span
            >
            <span
              class="bg-green-100 text-green-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-gray-700 dark:text-green-400 border border-green-400"
              >Tailwind</span
            >
            <span
              class="bg-green-100 text-green-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-gray-700 dark:text-green-400 border border-green-400"
              >React</span
            >
            <span
              class="bg-green-100 text-green-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-gray-700 dark:text-green-400 border border-green-400"
              >PostgreSQL</span
            >
          </div>
          <p class="font-normal">
            Plataforma web para refaccionarias que organiza clientes, autos y
            productos afiliados, facilita la comunicación con los clientes
            mediante chat y estados de servicio, y muestra fechas importantes en
            un calendario junto con detalles específicos de cada servicio.
          </p>
